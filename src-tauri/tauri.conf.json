{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novel Reader",
  "version": "0.1.0",
  "identifier": "com.novelreader.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Novel Reader",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "theme": "Light",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Novel Reader",
    "copyright": "© 2026 Novel Reader",
    "category": "Reference",
    "shortDescription": "本地 TXT / EPUB 小说阅读器",
    "longDescription": "Windows 本地小说阅读器：导入书架、五级目录管理、CSS 多栏分页、全文搜索高亮、进度记忆，支持导入本地字体。书只索引不复制，原文件始终保持原样。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
